# Copy to tiktok/.env (gitignored). Values here are read by every `ttk` command.

# Magnific plan API key (used as the bearer token for mcp.magnific.com in headless mode;
# leave empty to use the browser OAuth login instead)
MAGNIFIC_API_KEY=
# Magnific webhook secret (only needed if you wire Magnific webhooks; unused by the poller)
MAGNIFIC_WEBHOOK_SECRET=
# Override the MCP endpoint if Magnific moves it
MAGNIFIC_MCP_URL=https://mcp.magnific.com
# Port for the local OAuth callback
MAGNIFIC_OAUTH_PORT=8765

# Only for headless brief/storyboard generation (`ttk brief --llm`); not needed in chat mode
ANTHROPIC_API_KEY=
TTK_CLAUDE_MODEL=claude-opus-5
